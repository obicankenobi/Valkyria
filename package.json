{
  "name": "seventh-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "THE SEVENTH FRONT — turbaserad kallakrigssimulator. Monorepo-rot, ingen kod här.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "harness": "npm run build --workspace=packages/core --workspace=packages/harness && node packages/harness/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
